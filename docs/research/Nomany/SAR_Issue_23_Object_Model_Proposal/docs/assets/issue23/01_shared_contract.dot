digraph SAR {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.65", fontname="Helvetica", fontsize=18, labelloc=t, label="01 Shared data contract and composed metadata | proposed design"];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10, color="#334155", arrowsize=0.8];
"DataObject" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#edf2f7"><B>&lt;&lt;abstract, formal ABC proposed&gt;&gt;<BR/>DataObject</B></TD></TR><TR><TD ALIGN="LEFT">+ object_type: ObjectType<BR ALIGN="LEFT"/>+ object_id: str<BR ALIGN="LEFT"/>+ trace_id: str or None<BR ALIGN="LEFT"/>+ quality_status: str or None<BR ALIGN="LEFT"/>+ error_status: str or None<BR ALIGN="LEFT"/>+ payload: dict<BR ALIGN="LEFT"/>+ provenance: Provenance<BR ALIGN="LEFT"/>+ time_context: TimeContext<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ __post_init__(): None {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Provenance" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#edf2f7"><B>&lt;&lt;existing value object&gt;&gt;<BR/>Provenance</B></TD></TR><TR><TD ALIGN="LEFT">+ parent_object_ids: list[str]<BR ALIGN="LEFT"/>+ source_native_id: str or None<BR ALIGN="LEFT"/>+ created_by_component: str or None<BR ALIGN="LEFT"/>+ component_version: str or None<BR ALIGN="LEFT"/>+ configuration_version: str or None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"TimeContext" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#edf2f7"><B>&lt;&lt;existing value object&gt;&gt;<BR/>TimeContext</B></TD></TR><TR><TD ALIGN="LEFT">+ source_capture_time: datetime or None<BR ALIGN="LEFT"/>+ receipt_time: datetime or None<BR ALIGN="LEFT"/>+ processing_time: datetime or None<BR ALIGN="LEFT"/>+ valid_from / valid_until: datetime or None<BR ALIGN="LEFT"/>+ dispatch_time / completion_time: datetime or None<BR ALIGN="LEFT"/>+ clock_offset_estimate: float or None<BR ALIGN="LEFT"/>+ clock_quality / sync_source: str or None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ExecutionContext" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#edf2f7"><B>&lt;&lt;proposed, not implemented&gt;&gt;<BR/>ExecutionContext</B></TD></TR><TR><TD ALIGN="LEFT">+ session_id: str<BR ALIGN="LEFT"/>+ run_id: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DataObject -> Provenance [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="owns metadata"];
DataObject -> TimeContext [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="owns metadata"];
DataObject -> ExecutionContext [arrowhead=vee, taillabel="0..*", headlabel="0..1", label="candidate context reference"];

}
